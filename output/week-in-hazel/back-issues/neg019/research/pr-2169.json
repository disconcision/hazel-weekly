[{"url":"https://api.github.com/repos/hazelgrove/hazel/pulls/2169","id":3386412318,"node_id":"PR_kwDOBMdeZM7J2I0e","html_url":"https://github.com/hazelgrove/hazel/pull/2169","diff_url":"https://github.com/hazelgrove/hazel/pull/2169.diff","patch_url":"https://github.com/hazelgrove/hazel/pull/2169.patch","issue_url":"https://api.github.com/repos/hazelgrove/hazel/issues/2169","number":2169,"state":"closed","locked":false,"title":"Rewrite float negation as 0.0 -. e in ExpToSegment","user":{"login":"dm0n3y","id":8718124,"node_id":"MDQ6VXNlcjg3MTgxMjQ=","avatar_url":"https://avatars.githubusercontent.com/u/8718124?v=4","gravatar_id":"","url":"https://api.github.com/users/dm0n3y","html_url":"https://github.com/dm0n3y","followers_url":"https://api.github.com/users/dm0n3y/followers","following_url":"https://api.github.com/users/dm0n3y/following{/other_user}","gists_url":"https://api.github.com/users/dm0n3y/gists{/gist_id}","starred_url":"https://api.github.com/users/dm0n3y/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dm0n3y/subscriptions","organizations_url":"https://api.github.com/users/dm0n3y/orgs","repos_url":"https://api.github.com/users/dm0n3y/repos","events_url":"https://api.github.com/users/dm0n3y/events{/privacy}","received_events_url":"https://api.github.com/users/dm0n3y/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Terms support float-specific unary negation but tiles/segments don't at the moment. ExpToSegment sends both float negation and integer negation to the same UnaryMinus op, which means well-typed negative floats constructed as terms, serialized to segments, then parsed again as terms gain error holes. This modifies ExpToSegment so that it rewrites `-. f` in term form is serialized to `0.0 -. f` in segment form. Specifically, the parenthesize pass now rewrites UnOp(Float(Minus), e) to BinOp(Float(Minus), 0.0, e).","created_at":"2026-03-11T21:47:57Z","updated_at":"2026-04-21T12:25:35Z","clos