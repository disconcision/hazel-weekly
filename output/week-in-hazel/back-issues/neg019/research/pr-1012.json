[{"url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1012","id":1349862318,"node_id":"PR_kwDOBMdeZM5QdUOu","html_url":"https://github.com/hazelgrove/hazel/pull/1012","diff_url":"https://github.com/hazelgrove/hazel/pull/1012.diff","patch_url":"https://github.com/hazelgrove/hazel/pull/1012.patch","issue_url":"https://api.github.com/repos/hazelgrove/hazel/issues/1012","number":1012,"state":"closed","locked":false,"title":"Haz3l user defined operators","user":{"login":"shawn-stovall","id":7242918,"node_id":"MDQ6VXNlcjcyNDI5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/7242918?v=4","gravatar_id":"","url":"https://api.github.com/users/shawn-stovall","html_url":"https://github.com/shawn-stovall","followers_url":"https://api.github.com/users/shawn-stovall/followers","following_url":"https://api.github.com/users/shawn-stovall/following{/other_user}","gists_url":"https://api.github.com/users/shawn-stovall/gists{/gist_id}","starred_url":"https://api.github.com/users/shawn-stovall/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shawn-stovall/subscriptions","organizations_url":"https://api.github.com/users/shawn-stovall/orgs","repos_url":"https://api.github.com/users/shawn-stovall/repos","events_url":"https://api.github.com/users/shawn-stovall/events{/privacy}","received_events_url":"https://api.github.com/users/shawn-stovall/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Adding the ability for users to define their own operators.\r\n\r\nThis pull request makes changes to the external language's pattern and expression forms so that custom infix operators can be defined and applied. This then elaborates to an applied `DHExp.t` of the form `Ap(operator_variable, Tuple([arg1, a rg2]))`. The evaluator then continues unmodified to process the function application.\r\n\r\nFeatures:\r\n\r\n- `_op_` can be used in a normal let to define a new operator\r\n- `arg1 op arg2` can then be used without the underscores to apply the operator's function\r\n\r\nPotential Future Features:\r\n\r\n- `_op_` can be used in expressions to allow for typical function application (of the form `_op_(arg1, arg2)`).\r\n- `_op` and `op_` used to define postfix and prefix operators, respectively.","created_at":"2023-05-14T17:52:06Z","updated_at":"2026-04-21T12:55:15Z","closed_at":"2026-04-21T12:55:15Z","merged_at":null,"merge_commit_sha":null,"assignees":[{"login":"shawn-stovall","id":7242918,"node_id":"MDQ6VXNlcjcyNDI5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/7242918?v=4","gravatar_id":"","url":"https://api.github.com/users/shawn-stovall","html_url":"https://github.com/shawn-stovall","followers_url":"https://api.github.com/users/shawn-stovall/followers","following_url":"https://api.github.com/users/shawn-stovall/following{/other_user}","gists_url":"https://api.github.com/users/shawn-stovall/gists{/gist_id}","starred_url":"https://api.github.com/users/shawn-stovall/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shawn-stovall/subscriptions","organizations_url":"https://api.github.com/users/shawn-stovall/orgs","repos_url":"https://api.github.com/users/shawn-stovall/repos","events_url":"https://api.github.com/users/shawn-stovall/events{/privacy}","received_events_url":"https://api.github.com/users/shawn-stovall/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_reviewers":[{"login":"cyrus-","id":280638,"node_id":"MDQ6VXNlcjI4MDYzOA==","avatar_url":"https://avatars.githubusercontent.com/u/280638?v=4","gravatar_id":"","url":"https://api.github.com/users/cyrus-","html_url":"https://github.com/cyrus-","followers_url":"https://api.github.com/users/cyrus-/followers","following_url":"https://api.github.com/users/cyrus-/following{/other_user}","gists_url":"https://api.github.com/users/cyrus-/gists{/gist_id}","starred_url":"https://api.github.com/users/cyrus-/starred{/owner}{/repo}","subscriptions_url":"https://api.gi