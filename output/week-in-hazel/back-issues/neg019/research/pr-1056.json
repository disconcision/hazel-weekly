ic of LetOp(op, pat, def, body), where \"op\" is a string indicating which let-operator is used. \"pat\", \"def\", \"body\" is just the same as Let(pat, def, body).","created_at":"2023-06-27T20:20:27Z","updated_at":"2026-04-21T12:56:51Z","closed_at":"2026-04-21T12:56:50Z","merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[{"login":"disconcision","id":22436459,"node_id":"MDQ6VXNlcjIyNDM2NDU5","avatar_url":"https://avatars.githubusercontent.com/u/22436459?v=4","gravatar_id":"","url":"https://api.github.com/users/disconcision","html_url":"https://github.com/disconcision","followers_url":"https://api.github.com/users/disconcision/followers","following_url":"https://api.github.com/users/disconcision/following{/other_user}","gists_url":"https://api.github.com/users/disconcision/gists{/gist_id}","starred_url":"https://api.github.com/users/disconcision/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/disconcision/subscriptions","organizations_url":"https://api.github.com/users/disconcision/orgs","repos_url":"https://api.github.com/users/disconcision/repos","events_url":"https://api.github.com/users/disconcision/events{/privacy}","received_events_url":"https://api.github.com/users/disconcision/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1056/commits","review_comments_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1056/comments","review_comment_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/hazelgrove/hazel/issues/1056/comments","statuses_url":"https://api.github.com/repos/hazelgrove/hazel/statuses/4c93f3fee573c4f41c205cf41eb706e28cbecc67","head":{"label":"hazelgrove:let-operators","ref":"let-operators","sha":"4c93f3fee573c4f41c205cf41eb706e28cbecc67","user":{"login":"hazelgrove