[{"url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1154","id":1653027780,"node_id":"PR_kwDOBMdeZM5ihzPE","html_url":"https://github.com/hazelgrove/hazel/pull/1154","diff_url":"https://github.com/hazelgrove/hazel/pull/1154.diff","patch_url":"https://github.com/hazelgrove/hazel/pull/1154.patch","issue_url":"https://api.github.com/repos/hazelgrove/hazel/issues/1154","number":1154,"state":"closed","locked":false,"title":"Error flag for case expressions' associated DHExp","user":{"login":"pigumar1","id":108375845,"node_id":"U_kgDOBnWvJQ","avatar_url":"https://avatars.githubusercontent.com/u/108375845?v=4","gravatar_id":"","url":"https://api.github.com/users/pigumar1","html_url":"https://github.com/pigumar1","followers_url":"https://api.github.com/users/pigumar1/followers","following_url":"https://api.github.com/users/pigumar1/following{/other_user}","gists_url":"https://api.github.com/users/pigumar1/gists{/gist_id}","starred_url":"https://api.github.com/users/pigumar1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pigumar1/subscriptions","organizations_url":"https://api.github.com/users/pigumar1/orgs","repos_url":"https://api.github.com/users/pigumar1/repos","events_url":"https://api.github.com/users/pigumar1/events{/privacy}","received_events_url":"https://api.github.com/users/pigumar1/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This pull request aims to merge the three different case constructs in `DHExp` into one case construct.\r\n\r\nThe new approach will replace \r\n`DHExp.ConsistentCase(DHExp.case)`,\r\n`DHExp.InconsistentBranches(MetaVar.t, HoleInstanceId.t, DHExp.case)`,\r\n`DHExp.InexhaustiveCase(MetaVar.t, HoleInstanceId.t, DHExp.case)` (added for #1124),\r\nand `DHExp.case.Case(t, list(rule), int)`\r\n\r\nwith `DHExp.Case(t, list(rule), int, option((MetaVar.t, HoleInstanceId.t)))`, in which the last parameter indicates whether the corresponding case expression is inconsistent.\r\n\r\nTwo concerns:\r\n* Do we need to preserve the ability to distinguish consistent/inconsistent case expressions with `DHExp.constructor_string`? If so, the new `Case` construct, as well as the function `DHExp.constructor_string` would be a little bit more complex.\r\n* Do we need to preserve the ability to have different inconsistent case expressions behave (dynamically) differently? If so, `option` might not be enough.","created_at":"2023-12-21T02:58:49Z","updated_at":"2026-04-21T13:00:41Z","closed_at":"2026-04-21T13:00:41Z","merged_at":null,"merge_commit_sha":"3c10be0b2a16c8edd53ce7739a2930b963b2ab53","assignees":[],"requested_reviewers":[{"login":"cyrus-","id":280638,"node_id":"MDQ6VXNlcjI4MDYzOA==","avatar_url":"https://avatars.githubusercontent.com/u/280638?v=4","gravatar_id":"","url":"https://api.github.com/users/cyrus-","html_url":"https://github.com/cyrus-","followers_url":"https://api.github.com/users/cyrus-/followers","following_url":"https://api.github.com/users/cyrus-/following{/other_user}","gists_url":"https://api.github.com/users/cyrus-/gists{/gist_id}","starred_url":"https://api.github.com/users/cyrus-/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cyrus-/subscriptions","organizations_url":"https://api.github.com/users/cyrus-/orgs","repos_url":"https://api.github.com/users/cyrus-/repos","events_url":"https://api.github.com/users/cyrus-/events{/privacy}","received_events_url":"https://api.github.com/users/cyrus-/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1154/commits","review_comments_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/1154/comments","review_comment_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/hazelgrove/hazel/issues/1154/comments","statuses_url":"https://api.githu