    "title": "Modules II, part 1: first-class signature types and module values",
    "user": {
      "login": "7h3kk1d",
      "id": 995429,
      "node_id": "MDQ6VXNlcjk5NTQyOQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/995429?v=4",
