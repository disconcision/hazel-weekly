      "html_url": "https://github.com/disconcision",
      "followers_url": "https://api.github.com/users/disconcision/followers",
      "following_url": "https://api.github.com/users/disconcision/following{/other_user}",
      "gists_url": "https://api.github.com/users/disconcision/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/disconcision/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/disconcision/subscriptions",
      "organizations_url": "https://api.github.com/users/disconcision/orgs",
      "repos_url": "https://api.github.com/users/disconcision/repos",
      "events_url": "https://api.github.com/users/disconcision/events{/privacy}",
