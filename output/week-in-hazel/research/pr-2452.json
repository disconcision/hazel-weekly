    "title": "Fix: retain probes when fast-parsing almost-complete syntax",
    "user": {
      "login": "disconcision",
      "id": 22436459,
      "node_id": "MDQ6VXNlcjIyNDM2NDU5",
      "avatar_url": "https://avatars.githubusercontent.com/u/22436459?v=4",
      "gravatar_id": "",
