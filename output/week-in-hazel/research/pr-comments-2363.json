in sync with ProjectorView.offside_offset / stack_gap */\n+let offside_offset = 4;\n+let stack_gap = 2;\n+\n+type item = {\n+  row: int,\n+  origin_col: int,\n+  el: Js.t(Dom_html.element),\n+  w_px: float,\n+  h_px: float,\n+};\n+\n+let update = (~measured: Measured.t, ~font_metrics: FontMetrics.t): unit => {\n+  let nodes =\n+    Dom_html.document##querySelectorAll(Js.string(\".offside-wrapper\"));","path":"src/web/app/editors/decoration/ProbeStagger.re","commit_id":"b90c310d8be98626b745f2cb2e332911989dbef3","original_commit_id":"b90c310d8be98626b745f2cb2e332911989dbef3","user":{"login":"disconcision","id":22436459,"node_id":"MDQ6VXNlcjIyNDM2NDU5","avatar_url":"https://avatars.githubusercontent.com/u/22436459?v=4","gravatar_id":"","url":"https://api.github.com/users/disconcision","html_url":"https://github.com/disconcision","followers_url":"https://api.github.com/users/disconcision/followers","following_url":"https://api.github.com/users/disconcision/following{/other_user}","gists_url":"https://api.github.com/users/disconcision/gists{/gist_id}","starred_url":"https://api.github.com/users/disconcision/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/disconcision/subscriptions","organizations_url":"https://api.github.com/users/disconcision/orgs","repos_url":"https://api.github.com/users/disconcision/repos","events_url":"https://api.github.com/users/disconcision/events{/privacy}","received_events_url":"https://api.github.com/users/disconcision/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Correctness: this pass selects offside wrappers from the entire document, while Main passes measured from only Page.Update.get_editor. Scratch derivation slides, Tutorial, and Exercises can mount multiple CodeEditable cells, and row numbers are local to each cell. Wrappers in other cells therefore use the wrong line ends and collide through one global occupied set, so probes can be pushed unnecessarily or fail to clear their own code. Please run the pass per code container with that editor measurement, or attach an editor-scoped floor and identity to each wrapper.","created_at":"2026-09-02T20:51:04Z","updated_at":"2026-09-02T20:51:04Z","html_url":"https://github.com/hazelgrove/hazel/pull/2363#discussion_r3918535035","pull_request_url":"https://api.github.com/repos/hazelgrove/hazel/pulls/2363","_links":{"self":{"href":"https://api.github.com/repos/hazelgrove/hazel/pulls/comments/3918535035"},"html":{"href":"https://github.com/hazelgrove/hazel/pull/2363#discussion_r3918535035"},"pull_request":{"href":"https://api.github.com/repos/hazelgrove/hazel/pulls/2363"}},"reactions":{"url":"https://api.github.com/repos/hazelgrove/hazel/pulls/comments/3918535035/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":32,"side":"RIGHT","author_association":"MEMBER","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/hazelgrove/hazel/pulls/comments/3918535040","pull_request_review_id":5094954870,"id":3918535040,"node_id":"PRRC_kwDOBMdeZM7pkBmA","diff_hunk":"@@ -0,0 +1,80 @@\n+/* Cause-driven compensation for refractor (probe-drawer) height changes above\n+ * the caret: when a drawer above the locus grows/shrinks, scroll #main by the\n+ * exact row delta so the caret stays put. Gated on refractor_rows ref\n+ * identity (zero work on unrelated frames). Replaces the old symptom-driven\n+ * CaretAnchor, which conflated drawer shifts with unrelated caret motion. */\n+\n+open Js_of_ocaml;\n+open Haz3lcore;\n+\n+let prev_rows: ref(option(Id.Map.t(int))) = ref(None);","path":"src/web/RefractorShift.re","commit_id":"b90c310d8be98626b745f2cb2e332911989dbef3","original_commit_id":"b90c310d8be98626b745f2cb2e332911989dbef3","user":{"login":"disconcision","id":22436459,"node_id":"MDQ6VXNlcjIyNDM2NDU5","avatar_url":"https://avata